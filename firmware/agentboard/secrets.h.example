#pragma once
// agentboard secrets
// 默认走 USB 推送（agentboard.ino 里 USE_WIFI 0），不需要 WiFi。
// 若切到 USE_WIFI 1（ESP 主动轮询），填下面三项并保持 Mac 与屏幕同一局域网。
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASS     "YOUR_WIFI_PASSWORD"
#define BOARD_HOST    "192.168.18.27"   // Mac 的局域网 IP
#define BOARD_PORT    8899
